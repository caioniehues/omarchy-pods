#!/bin/bash
# Fork-only guardrail for build: secrets, em dashes in added lines, and the suites the staged paths touch.
# The suites build the working tree, so unstaged edits to the same files are tested too.
# Install in a clone: ln -s ../../.githooks/pre-commit .git/hooks/pre-commit (same for commit-msg).
set -uo pipefail
root=$(git rev-parse --show-toplevel)
cd "$root" || exit 1
fail() { printf 'pre-commit: %s\n' "$1" >&2; exit 1; }

gitleaks git --pre-commit --staged --no-banner --redact --log-level warn || fail "gitleaks found a secret in the staged change."

dashes=$(git diff --cached -U0 --no-color | rg -n '^\+[^+].*\x{2014}' || true)
[ -z "$dashes" ] || fail "$(printf 'em dash in an added line (CONTRIBUTING.md: commas, parentheses or a rewrite):\n%s' "$dashes")"

staged=$(git diff --cached --name-only)
if printf '%s\n' "$staged" | rg -q '^daemon/'; then
  [ -f daemon/build/build.ninja ] || cmake -S daemon -B daemon/build -G Ninja >/dev/null || fail "cmake configure failed."
  out=$(cmake --build daemon/build 2>&1) || fail "$(printf 'daemon build failed:\n%s' "$(printf '%s\n' "$out" | rg -i -A3 'error' | head -40)")"
  out=$(ctest --test-dir daemon/build --output-on-failure 2>&1) || fail "$(printf 'ctest failed:\n%s' "$(printf '%s\n' "$out" | tail -40)")"
fi
if printf '%s\n' "$staged" | rg -q '^(Model\.js|tests/)'; then
  out=$(npx -y deno run --allow-read tests/model.test.js 2>&1) || fail "$(printf 'tests/model.test.js failed:\n%s' "$out")"
fi
if printf '%s\n' "$staged" | rg -q '^(Model\.js|ConnectionEvents\.js|tests/)'; then
  out=$(npx -y deno run --allow-read tests/connection-events.test.js 2>&1) || fail "$(printf 'tests/connection-events.test.js failed:\n%s' "$out")"
fi
exit 0
